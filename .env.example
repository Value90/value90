# Supabase: el valor anon/public es visible en el navegador; protéjelo con RLS en Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. No añadir el prefijo NEXT_PUBLIC_ a una clave secreta.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_PARTICIPATION_MODEL=

# Dirección canónica pública y datos del titular que se mostrarán en las páginas legales.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_OPERATOR=
NEXT_PUBLIC_SITE_TAX_ID=
NEXT_PUBLIC_SITE_ADDRESS=
NEXT_PUBLIC_SITE_REGISTRATION=
NEXT_PUBLIC_CONTACT_EMAIL=

# AdSense: publisher ID ca-pub-... y el ID numérico de la unidad superior.
# El ancla inferior se configura en Auto ads dentro de AdSense.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=
